{
  "name": "@workflow/world-cloudflare",
  "version": "0.2.0",
  "private": true,
  "description": "Workflow SDK World on Cloudflare Durable Objects",
  "type": "module",
  "exports": {
    ".": {
      "worlds-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./stubs/*": {
      "types": "./dist/stubs/*.d.ts",
      "default": "./dist/stubs/*.js"
    },
    "./remote": {
      "types": "./dist/remote/client.d.ts",
      "default": "./dist/remote/client.js"
    }
  },
  "files": [
    "dist",
    "src",
    "drizzle/*/migrations.js",
    "drizzle/*/*.sql",
    "drizzle/*/meta/_journal.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "db:generate": "drizzle-kit generate --config drizzle/store.config.ts && drizzle-kit generate --config drizzle/queue.config.ts && drizzle-kit generate --config drizzle/streams.config.ts"
  },
  "dependencies": {
    "@workflow/builders": "5.1.0",
    "@workflow/errors": "5.1.1",
    "@workflow/world": "5.2.0",
    "devalue": "6.0.3",
    "drizzle-orm": "0.45.4",
    "durability": "5.2.1",
    "esbuild": "0.28.2",
    "ulid": "3.0.2",
    "workers-qb": "1.16.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261113.1",
    "drizzle-kit": "0.31.11"
  }
}
