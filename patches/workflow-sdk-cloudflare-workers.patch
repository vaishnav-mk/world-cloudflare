@@ -0,0 +1,93 @@
+import type { Event } from '@workflow/world';
+import { slotToEventId } from '@workflow/world';
+import { describe, expect, it } from 'vitest';
+import {
+  eventLogRevision,
+  markEventLogRewritten,
+  memoizeEventLog,
+} from './event-log-memo.js';
+import {
+  appendUniqueEvents,
+  findEventSlotGap,
+  insertEventByEventId,
+  mergeReportedEvents,
+} from './helpers.js';
+
+const event = (slot: number): Event =>
+  ({
+    eventId: slotToEventId(slot),
+    runId: 'wrun_memo',
+    eventType: 'step_started',
+    correlationId: `step_${slot}`,
+    createdAt: new Date(0),
+  }) as Event;
+
+/** A memo that records which events it read. */
+function readingMemo() {
+  const read: string[] = [];
+  const memo = memoizeEventLog(
+    () => new Set<string>(),
+    (ids, e) => {
+      read.push(e.eventId);
+      ids.add(e.eventId);
+    }
+  );
+  return { read, memo };
+}
+
+describe('memoizeEventLog', () => {
+  it('reads each appended event once across calls', () => {
+    const { read, memo } = readingMemo();
+    const log = [event(1), event(2)];
+    expect(memo(log).size).toBe(2);
+    log.push(event(3));
+    expect(memo(log).size).toBe(3);
+    expect(memo(log).size).toBe(3);
+    expect(read).toEqual([1, 2, 3].map(slotToEventId));
+  });
+
+  it('starts over after a rewrite is marked', () => {
+    const { read, memo } = readingMemo();
+    const log = [event(1), event(2)];
+    memo(log);
+    log[0] = event(5);
+    markEventLogRewritten(log);
+    expect(eventLogRevision(log)).toBe(1);
+    expect([...memo(log)]).toEqual([5, 2].map(slotToEventId));
+    expect(read).toHaveLength(4);
+  });
+
+  it('starts over when the log shrank or an event was inserted below its read position', () => {
+    const { memo } = readingMemo();
+    const log = [event(1), event(3)];
+    memo(log);
+    log.splice(1, 0, event(2));
+    expect([...memo(log)].sort()).toEqual([1, 2, 3].map(slotToEventId));
+    log.length = 1;
+    expect([...memo(log)]).toEqual([slotToEventId(1)]);
+  });
+});
+
+describe('event log helpers on one growing log', () => {
+  it('see holes and duplicates across appends and in-place rewrites', () => {
+    const log = [event(1), event(2), event(4)];
+    expect(findEventSlotGap(log)?.firstMissingSlot).toBe(3);
+
+    // A skipped-slot report fills the hole, sorting the log in place.
+    expect(mergeReportedEvents(log, [event(3)])).toBe(1);
+    expect(findEventSlotGap(log)).toBeUndefined();
+
+    appendUniqueEvents(log, [event(4), event(6)]);
+    expect(log.map((e) => e.eventId)).toEqual(
+      [1, 2, 3, 4, 6].map(slotToEventId)
+    );
+    expect(findEventSlotGap(log)?.firstMissingSlot).toBe(5);
+
+    insertEventByEventId(log, event(5));
+    expect(findEventSlotGap(log)).toBeUndefined();
+    appendUniqueEvents(log, [event(5), event(7)]);
+    expect(log.map((e) => e.eventId)).toEqual(
+      [1, 2, 3, 4, 5, 6, 7].map(slotToEventId)
+    );
+  });
+});
