new file mode 100644
index 000000000..99f4eae70
--- /dev/null
+++ b/packages/core/src/vm/isolate.ts
@@ -0,0 +1,122 @@
+import { WorkflowRuntimeError } from '@workflow/errors';
+import { runtimeLogger } from '../logger.js';
+import { type CreateContextOptions, installWorkflowGlobals } from './index.js';
+
+/**
+ * The isolate engine (`WORKFLOW_VM=isolate`) for runtimes without `node:vm`
+ * or `eval`, such as Cloudflare Workers. A build (`--target
+ * cloudflare-workers`) compiles the workflow bundle into a factory function
+ * that takes every global as a parameter. Each replay calls it with a fresh
+ * sandbox object, so module state starts clean and globals resolve to the
+ * sandbox's deterministic values, the way a fresh `vm.Context` does.
+ *
+ * Unlike node:vm, the sandbox shares the host realm's intrinsics
+ * (`Object.prototype`, `Array.prototype`...), so workflow code that patches
+ * them affects the host. Like node:vm, it is not a security boundary.
+ */
+export interface IsolateWorkflowBundle {
+  /** The bundle source the factory was compiled from, as passed to `workflowEntrypoint`. */
+  readonly code: string;
+  /** Globals the factory shadows, in parameter order after `globalThis`. */
+  readonly names: readonly string[];
+  readonly evaluate: (globalThis: object, ...globals: unknown[]) => void;
+}
+
+export const ISOLATE_BUNDLE_KEY = Symbol.for(
+  '@workflow/core//isolateWorkflowBundle'
+);
+
+/** ECMAScript globals the sandbox copies from the host, as a fresh vm.Context has them. */
+const INTRINSICS = [
+  'Object', 'Function', 'Array', 'Number', 'parseFloat', 'parseInt',
+  'Infinity', 'NaN', 'undefined', 'Boolean', 'String', 'Symbol', 'Date',
+  'Promise', 'RegExp', 'Error', 'AggregateError', 'EvalError', 'RangeError',
+  'ReferenceError', 'SyntaxError', 'TypeError', 'URIError', 'JSON', 'Math',
+  'Intl', 'ArrayBuffer', 'Atomics', 'Uint8Array', 'Int8Array', 'Uint16Array',
+  'Int16Array', 'Uint32Array', 'Int32Array', 'BigUint64Array',
+  'BigInt64Array', 'Uint8ClampedArray', 'Float32Array', 'Float64Array',
+  'Float16Array', 'DataView', 'Map', 'BigInt', 'Set', 'Iterator', 'WeakMap',
+  'WeakSet', 'Proxy', 'Reflect', 'FinalizationRegistry', 'WeakRef',
+  'decodeURI', 'decodeURIComponent', 'encodeURI', 'encodeURIComponent',
+  'escape', 'unescape', 'isFinite', 'isNaN', 'SuppressedError',
+  'DisposableStack', 'AsyncDisposableStack', 'SharedArrayBuffer',
+  'WebAssembly',
+];
+
+/** A fresh sandbox global for one replay. Same shape as `createContext`'s. */
+export function createIsolateContext(options: CreateContextOptions) {
+  const host = globalThis as unknown as Record<string, unknown>;
+  const g: Record<string, unknown> = {};
+  for (const name of INTRINSICS) if (name in host) g[name] = host[name];
+  g.globalThis = g;
+  const installed = installWorkflowGlobals(
+    g as unknown as typeof globalThis,
+    options,
+    true
+  );
+  return { context: g, ...installed };
+}
+
+/**
+ * Evaluates the deployment's workflow factory against `sandbox` and returns
+ * the workflow named `workflowName`, as the node:vm bundle and lookup scripts
+ * do. Only the bundle compiled into this deployment can run: there is no way
+ * to compile other source (a dynamic workflow) without `eval`.
+ */
+export function evaluateIsolateWorkflow(
+  workflowCode: string,
+  sandbox: typeof globalThis,
+  workflowName: string
+): unknown {
+  const bundle = (globalThis as { [ISOLATE_BUNDLE_KEY]?: IsolateWorkflowBundle })[
+    ISOLATE_BUNDLE_KEY
+  ];
+  if (bundle?.code !== workflowCode) {
+    throw new WorkflowRuntimeError(
+      'The isolate workflow engine runs only the workflow bundle compiled into this deployment (`workflow build --target cloudflare-workers`). Dynamic workflow code needs WORKFLOW_VM=quickjs.'
+    );
+  }
+  warnUnshadowedGlobals(bundle.names);
+  const g = sandbox as unknown as Record<string, unknown>;
+  bundle.evaluate(g, ...bundle.names.map((name) => g[name]));
+  const workflows = g.__private_workflows as Map<string, unknown> | undefined;
+  return workflows?.get(workflowName);
+}
+
+// per-copy-ok: a diagnostic; each module copy warning once is fine.
+let checkedGlobals = false;
+
+/**
+ * Host globals the factory does not shadow stay reachable from workflow code.
+ * The build's list covers workerd and Node; warn once when the host has more.
+ */
+function warnUnshadowedGlobals(names: readonly string[]): void {
+  if (checkedGlobals) return;
+  checkedGlobals = true;
+  const shadowed = new Set([
+    ...names,
+    'globalThis',
+    'eval',
+    'undefined',
+    'NaN',
+    'Infinity',
+  ]);
+  const unshadowed = new Set<string>();
+  for (
+    let scope: object | null = globalThis;
+    scope && scope !== Object.prototype;
+    scope = Object.getPrototypeOf(scope)
+  ) {
+    for (const name of Object.getOwnPropertyNames(scope)) {
+      if (!shadowed.has(name) && /^[A-Za-z_$][\w$]*$/.test(name)) {
+        unshadowed.add(name);
+      }
+    }
+  }
+  if (unshadowed.size > 0) {
+    runtimeLogger.warn(
+      'Host globals visible to workflow code on the isolate engine',
+      { globals: [...unshadowed].join(', ') }
+    );
+  }
+}
