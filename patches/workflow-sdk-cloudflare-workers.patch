@@ -0,0 +1,74 @@
+import {
+  existsSync,
+  mkdtempSync,
+  readFileSync,
+  rmSync,
+  writeFileSync,
+} from 'node:fs';
+import { join, resolve } from 'node:path';
+import { afterEach, expect, it } from 'vitest';
+import { StandaloneBuilder } from './standalone.js';
+import type { StandaloneConfig } from './types.js';
+
+const repoRoot = resolve(import.meta.dirname, '../../..');
+const outputDirs: string[] = [];
+
+afterEach(() => {
+  for (const dir of outputDirs) rmSync(dir, { recursive: true, force: true });
+});
+
+it.each([
+  'standalone',
+  'cloudflare-workers',
+] as const)('%s emits the appropriate banner and static WASM imports', async (buildTarget) => {
+  // Put the fixture inside the workflow package so self-referencing imports resolve.
+  const workingDir = mkdtempSync(
+    join(repoRoot, 'packages/workflow/.workers-builder-')
+  );
+  outputDirs.push(workingDir);
+  writeFileSync(
+    join(workingDir, 'example.ts'),
+    'export async function run() { "use workflow"; return 1; }'
+  );
+  const config: StandaloneConfig = {
+    buildTarget,
+    workingDir,
+    dirs: ['.'],
+    sourcemap: false,
+    stepsBundlePath: '.well-known/workflow/v1/__step_registrations.mjs',
+    workflowsBundlePath: '.well-known/workflow/v1/flow.mjs',
+    webhookBundlePath: '.well-known/workflow/v1/webhook.mjs',
+  };
+  await new StandaloneBuilder(config).build();
+  const bundle = readFileSync(
+    join(workingDir, config.workflowsBundlePath),
+    'utf8'
+  );
+  expect(
+    bundle.includes('var require = __createRequire(import.meta.url)')
+  ).toBe(buildTarget === 'standalone');
+  // The isolate engine's factory: the same bundle, with globals as parameters.
+  expect(bundle.includes('code: workflowCode,')).toBe(
+    buildTarget === 'cloudflare-workers'
+  );
+  // A Workers flow route imports its steps module instead of inlining it.
+  expect(bundle.includes('from "./__step_registrations.mjs"')).toBe(
+    buildTarget === 'cloudflare-workers'
+  );
+  for (const name of [
+    'runtime',
+    'encoding',
+    'headers',
+    'url',
+    'structuredClone',
+  ]) {
+    expect(bundle.includes(`./__quickjs_${name}.wasm`)).toBe(
+      buildTarget === 'cloudflare-workers'
+    );
+    expect(
+      existsSync(
+        join(workingDir, '.well-known/workflow/v1', `__quickjs_${name}.wasm`)
+      )
+    ).toBe(buildTarget === 'cloudflare-workers');
+  }
+});
