--- /dev/null
+++ b/packages/core/src/runtime/event-log-memo.ts
@@ -0,0 +1,66 @@
+import type { Event } from '@workflow/world';
+
+/*
+ * Facts derived from a loaded event log, kept per log array and extended
+ * with only the events appended since the last read.
+ *
+ * The replay loop keeps one log array per invocation, grows it with `push`,
+ * and re-derives the same facts from it on every iteration: its event ids,
+ * its slots, whether it holds a terminal run event. Reading the whole log
+ * each time made every step cost O(events) and a run O(events²).
+ *
+ * Appending is the only mutation a memo follows. A helper that rewrites a log
+ * in place (`mergeReportedEvents` sorts, `insertEventByEventId` splices) calls
+ * `markEventLogRewritten`. A memo also starts over when the log shrank or the
+ * event at its read position moved, which catches an insertion below it.
+ */
+
+// per-copy-ok: keyed on log arrays, which one copy's replay loop creates,
+// rewrites and reads. Another copy never holds the key.
+const revisions = new WeakMap<readonly Event[], number>();
+
+/** Bumps `events`' revision: its existing positions may hold other events now. */
+export function markEventLogRewritten(events: readonly Event[]): void {
+  revisions.set(events, eventLogRevision(events) + 1);
+}
+
+/** How many times `events` was rewritten in place. Appends do not count. */
+export function eventLogRevision(events: readonly Event[]): number {
+  return revisions.get(events) ?? 0;
+}
+
+interface Memo<T> {
+  revision: number;
+  read: number;
+  last: Event | undefined;
+  state: T;
+}
+
+/**
+ * Returns a function that folds a log's events into `init()` with `add`,
+ * reading each event of an append-only log once across calls.
+ */
+export function memoizeEventLog<T>(
+  init: () => T,
+  add: (state: T, event: Event) => void
+): (events: readonly Event[]) => T {
+  const memos = new WeakMap<readonly Event[], Memo<T>>();
+  return (events) => {
+    const revision = eventLogRevision(events);
+    let memo = memos.get(events);
+    if (
+      memo === undefined ||
+      memo.revision !== revision ||
+      memo.read > events.length ||
+      events[memo.read - 1] !== memo.last
+    ) {
+      memo = { revision, read: 0, last: undefined, state: init() };
+      memos.set(events, memo);
+    }
+    for (; memo.read < events.length; memo.read++) {
+      add(memo.state, events[memo.read]);
+    }
+    memo.last = events[memo.read - 1];
+    return memo.state;
+  };
+}
