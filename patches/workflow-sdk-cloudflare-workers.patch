+import {
+  type CreateEventRequest,
+  SPEC_VERSION_CURRENT,
+  type WorkflowRun,
+  type World,
+} from '@workflow/world';
+import { afterEach, expect, it, vi } from 'vitest';
+import { runWorkflowWithQuickJS } from './quickjs-entrypoint.js';
+import { startQuickJSWorkflow } from './quickjs-runtime.js';
+import { executeStep } from './step-executor.js';
+import { setWorld } from './world.js';
+
+vi.mock('@vercel/functions', () => ({ waitUntil: vi.fn() }));
+vi.mock('./get-port-lazy.js', () => ({ getPortLazy: async () => 3000 }));
+vi.mock('./quickjs-runtime.js', () => ({ startQuickJSWorkflow: vi.fn() }));
+vi.mock('./step-executor.js', () => ({ executeStep: vi.fn() }));
+
+afterEach(() => {
+  setWorld(undefined);
+  vi.restoreAllMocks();
+  vi.clearAllMocks();
+  delete process.env.WORKFLOW_V2_TIMEOUT_MS;
+});
+
+const now = new Date('2026-05-19T12:00:00.000Z');
+const workflowRun: WorkflowRun = {
+  runId: 'wrun_quickjs_inline_window',
+  workflowName: 'workflow',
+  status: 'running',
+  input: [],
+  deploymentId: 'dpl_quickjs_inline_window',
+  specVersion: SPEC_VERSION_CURRENT,
+  startedAt: now,
+  createdAt: now,
+  updatedAt: now,
+};
+
+it('requeues instead of running steps inline once the inline window closes', async () => {
+  // Like the node engine, QuickJS stops inlining after the inline window so
+  // a long run of steps suspends cleanly instead of being cut off by the
+  // platform mid-invocation.
+  process.env.WORKFLOW_V2_TIMEOUT_MS = '1';
+  let clock = now.getTime();
+  vi.spyOn(Date, 'now').mockImplementation(() => (clock += 1000));
+
+  const created: CreateEventRequest[] = [];
+  const queued: { payload: any; opts: any }[] = [];
+  setWorld({
+    specVersion: SPEC_VERSION_CURRENT,
+    capabilities: {},
+    events: {
+      list: async () => ({ data: [], cursor: null, hasMore: false }),
+      create: async (_runId: string, request: CreateEventRequest) => {
+        created.push(request);
+        return {
+          event: { ...request, runId: workflowRun.runId, eventId: 'evnt_1' },
+        };
+      },
+    },
+    runs: { get: async () => workflowRun },
+    queue: async (_queueName: string, payload: unknown, opts: unknown) => {
+      queued.push({ payload, opts });
+      return { messageId: null };
+    },
+    getDeploymentId: async () => workflowRun.deploymentId,
+    getEncryptionKeyForRun: async () => undefined,
+  } as unknown as World);
+  vi.mocked(startQuickJSWorkflow).mockImplementation(async () => ({
+    result: {
+      suspended: {
+        pendingOperations: [
+          {
+            type: 'step',
+            correlationId: 'step_inline_window',
+            stepId: 'step//inline//window',
+            input: new Uint8Array([1]),
+            hasCreatedEvent: false,
+          },
+        ],
+      },
+    },
+    continueWithEvents: vi.fn(),
+    dispose: vi.fn(),
+  }));
+
+  await runWorkflowWithQuickJS({
+    workflowCode: '',
+    workflowName: workflowRun.workflowName,
+    workflowRun,
+  });
+
+  expect(executeStep).not.toHaveBeenCalled();
+  expect(created.map((e) => e.eventType)).not.toContain('step_started');
+  const replays = queued.filter((q) => q.payload?.stepId === undefined);
+  expect(replays).toHaveLength(1);
+  expect(replays[0].payload).toMatchObject({ runId: workflowRun.runId });
+});
