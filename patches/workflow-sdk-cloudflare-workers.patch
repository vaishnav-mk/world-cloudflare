+import * as vm from 'node:vm';
+import { afterEach, describe, expect, it } from 'vitest';
+import { createContext } from './index.js';
+import {
+  createIsolateContext,
+  evaluateIsolateWorkflow,
+  ISOLATE_BUNDLE_KEY,
+  type IsolateWorkflowBundle,
+} from './isolate.js';
+
+const options = { seed: 'entropy seed', fixedTimestamp: 1234567890000 };
+const host = globalThis as { [ISOLATE_BUNDLE_KEY]?: IsolateWorkflowBundle };
+
+afterEach(() => {
+  delete host[ISOLATE_BUNDLE_KEY];
+});
+
+describe('createIsolateContext', () => {
+  it('draws the same values as the node:vm context for the same seed', () => {
+    const { globalThis: g } = createIsolateContext(options);
+    const { context } = createContext(options);
+    const expected = [0, 1, 2].map(() => vm.runInContext('Math.random()', context));
+    expect([0, 1, 2].map(() => g.Math.random())).toEqual(expected);
+    expect(g.crypto.randomUUID()).toBe(
+      vm.runInContext('crypto.randomUUID()', context)
+    );
+  });
+
+  it('fixes time and hides host timing without touching host intrinsics', () => {
+    const { globalThis: g, updateTimestamp } = createIsolateContext(options);
+    expect(g.Date.now()).toBe(options.fixedTimestamp);
+    expect(new g.Date().getTime()).toBe(options.fixedTimestamp);
+    updateTimestamp(options.fixedTimestamp + 5);
+    expect(g.Date.now()).toBe(options.fixedTimestamp + 5);
+    expect(new g.Date(0)).toBeInstanceOf(Date);
+    expect(g.WeakRef).toBeUndefined();
+    expect(g.Atomics.waitAsync).toBeUndefined();
+    expect(g.WebAssembly.compile).toBeUndefined();
+
+    expect(Date.now()).not.toBe(options.fixedTimestamp);
+    expect(g.Math.random).not.toBe(Math.random);
+    expect(typeof WeakRef).toBe('function');
+    expect(typeof WebAssembly.compile).toBe('function');
+  });
+});
+
+describe('evaluateIsolateWorkflow', () => {
+  const code = 'the bundle source';
+  // What the cloudflare-workers build emits: the bundle inside a function
+  // whose parameters shadow globals.
+  const register = () => {
+    host[ISOLATE_BUNDLE_KEY] = {
+      code,
+      names: ['Math', 'setTimeout'],
+      evaluate: function (globalThis: any, Math: any, setTimeout: any) {
+        let calls = 0;
+        globalThis.__private_workflows = new Map([
+          ['wf', () => ({ calls: ++calls, random: Math.random(), setTimeout })],
+        ]);
+      } as IsolateWorkflowBundle['evaluate'],
+    };
+  };
+
+  it('gives every replay fresh module state and the sandbox globals', () => {
+    register();
+    const run = () => {
+      const { globalThis: g } = createIsolateContext(options);
+      return (evaluateIsolateWorkflow(code, g, 'wf') as () => unknown)();
+    };
+    const first = run();
+    expect(first).toEqual(run());
+    expect(first).toMatchObject({ calls: 1, setTimeout: undefined });
+  });
+
+  it('rejects source that was not compiled into the deployment', () => {
+    register();
+    const { globalThis: g } = createIsolateContext(options);
+    expect(() => evaluateIsolateWorkflow('other source', g, 'wf')).toThrow(
+      /Dynamic workflow code needs WORKFLOW_VM=quickjs/
+    );
+  });
+});
