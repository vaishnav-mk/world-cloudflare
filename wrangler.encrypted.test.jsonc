{
  "name": "workflow-sdk-cloudflare-test",
  "workers_dev": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // The app test config with an encryption secret, and without WORKFLOW_SNAPSHOT_ALLOW_UNENCRYPTED. A test value: use
  // `wrangler secret put WORKFLOW_ENCRYPTION_SECRET` for a real Worker.
  "vars": { "DEPLOYMENT_ID": "test-v1", "WORKFLOW_VM": "quickjs", "WORKFLOW_COMPRESSION_CODEC": "gzip",
    "WORKFLOW_SNAPSHOT_THRESHOLD": "2", "WORKFLOW_ENCRYPTION_SECRET": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=" },
  "durable_objects": { "bindings": [
    { "name": "WORLD_STORE", "class_name": "WorldStore" },
    { "name": "QUEUE_SHARD", "class_name": "QueueShard" },
    { "name": "RUN_STREAMS", "class_name": "RunStreams" },
    { "name": "RUNNER", "class_name": "Runner" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldStore", "QueueShard", "RunStreams"] }, { "tag": "v2", "new_sqlite_classes": ["Runner"] }],
  "r2_buckets": [
    { "binding": "DLQ", "bucket_name": "workflow-sdk-test-dlq" },
    { "binding": "PAYLOADS", "bucket_name": "workflow-sdk-test-payloads" }
  ],
  "services": [{ "binding": "CONSUMER", "service": "workflow-sdk-cloudflare-test", "entrypoint": "QueueConsumer" }]
}
