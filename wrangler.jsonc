{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workflow-sdk-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  // The SDK imports these, and they do not load on Workers; see @workflow/world-cloudflare/build.
  "alias": {
    "@workflow/world-local": "@workflow/world-cloudflare/stubs/world",
    "@workflow/world-vercel": "@workflow/world-cloudflare/stubs/world",
    "@vercel/functions": "@workflow/world-cloudflare/stubs/vercel-functions"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // Without a WORKFLOW_ENCRYPTION_SECRET secret, VM snapshots are stored unencrypted, like every payload; see docs/limits.md.
  "vars": { "DEPLOYMENT_ID": "dev-v1", "WORKFLOW_VM": "quickjs", "WORKFLOW_COMPRESSION_CODEC": "gzip", "WORKFLOW_SNAPSHOT_ALLOW_UNENCRYPTED": "1" },
  "durable_objects": { "bindings": [
    { "name": "WORLD_STORE", "class_name": "WorldStore" },
    { "name": "QUEUE_SHARD", "class_name": "QueueShard" },
    { "name": "RUN_STREAMS", "class_name": "RunStreams" },
    { "name": "RUNNER", "class_name": "Runner" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldStore", "QueueShard", "RunStreams"] }, { "tag": "v2", "new_sqlite_classes": ["Runner"] }],
  "r2_buckets": [
    { "binding": "DLQ", "bucket_name": "workflow-sdk-dlq" },
    { "binding": "PAYLOADS", "bucket_name": "workflow-sdk-payloads" }
  ],
  "services": [{ "binding": "CONSUMER", "service": "workflow-sdk-cloudflare", "entrypoint": "QueueConsumer" }],
  "triggers": { "crons": ["* * * * *"] },
  // The SDK makes about one Durable Object call per event; the 10,000 default ends long inline invocations.
  "limits": { "cpu_ms": 300000, "subrequests": 1000000 },
  "observability": { "enabled": true }
}
