{
  // Template for one immutable executor per deployment. Upload it to the dispatch namespace bound as
  // EXECUTORS on the main Worker, then add its DEPLOYMENT_ID to that Worker's EXECUTOR_ROUTES.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workflow-sdk-executor-v1",
  "main": "src/executor.ts",
  "workers_dev": false,
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  // The SDK imports these, and they do not load on Workers; see @workflow/world-cloudflare/build.
  "alias": {
    "@workflow/world-local": "@workflow/world-cloudflare/stubs/world",
    "@workflow/world-vercel": "@workflow/world-cloudflare/stubs/world",
    "@vercel/functions": "@workflow/world-cloudflare/stubs/vercel-functions"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // Without a WORKFLOW_ENCRYPTION_SECRET secret, VM snapshots are stored unencrypted, like every payload; see packages/world-cloudflare/README.md#encryption.
  "vars": { "DEPLOYMENT_ID": "v1", "WORKFLOW_VM": "quickjs", "WORKFLOW_COMPRESSION_CODEC": "gzip", "WORKFLOW_SNAPSHOT_ALLOW_UNENCRYPTED": "1" },
  "durable_objects": { "bindings": [
    { "name": "WORLD_STORE", "class_name": "WorldStore", "script_name": "workflow-sdk-cloudflare" },
    { "name": "QUEUE_SHARD", "class_name": "QueueShard", "script_name": "workflow-sdk-cloudflare" },
    { "name": "RUN_STREAMS", "class_name": "RunStreams", "script_name": "workflow-sdk-cloudflare" },
    { "name": "RUNNER", "class_name": "Runner", "script_name": "workflow-sdk-cloudflare" }
  ] },
  "r2_buckets": [
    { "binding": "DLQ", "bucket_name": "workflow-sdk-dlq" },
    { "binding": "PAYLOADS", "bucket_name": "workflow-sdk-payloads" }
  ],
  "services": [{ "binding": "CONSUMER", "service": "workflow-sdk-cloudflare", "entrypoint": "QueueConsumer" }],
  // The SDK makes about one Durable Object call per event; the 10,000 default ends long inline invocations.
  "limits": { "cpu_ms": 300000, "subrequests": 1000000 },
  "observability": { "enabled": true }
}
