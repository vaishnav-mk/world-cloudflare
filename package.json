{
  "name": "world-cloudflare-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.app.config.ts && vitest run --config vitest.node.config.ts && vitest run --config vitest.encrypted.config.ts && vitest run --config vitest.spec9.config.ts",
    "build:workflow": "rm -rf .wrangler/tmp && node packages/world-cloudflare/src/build.ts workflows",
    "typecheck": "wrangler types --config wrangler.test.jsonc worker-configuration.d.ts && tsc --noEmit",
    "build": "pnpm run build:workflow && wrangler deploy --dry-run --outdir /tmp/worlds-cloudflare-build",
    "ui": "pnpm --filter @workflow/world-cloudflare build && node --env-file=.dev.vars.remote-ui node_modules/@workflow/cli/bin/run.js web"
  },
  "dependencies": {
    "@workflow/cli": "5.1.0",
    "@workflow/errors": "5.1.1",
    "@workflow/world": "5.2.0",
    "@workflow/world-cloudflare": "workspace:*",
    "workflow": "5.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.1",
    "@types/node": "26.6.6",
    "devalue": "6.0.3",
    "drizzle-orm": "0.45.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  }
}
