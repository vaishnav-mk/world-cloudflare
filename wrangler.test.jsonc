{
  "name": "worlds-test",
  "workers_dev": false,
  "main": "test/worker.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "vars": {
    "DEPLOYMENT_ID": "test-v1", "QUEUE_MAX_ATTEMPTS": "2",
    // workerd ignores the hint; test/location-hint.test.ts checks every object the World reaches gets it.
    "LOCATION_HINT": "weur",
    // Two epochs: runs minted now land in the second; IDs without a ULID time stay in the first.
    // Fewer index shards than store shards, so a list that asks only the index asks fewer objects.
    "SHARD_EPOCHS": "[{\"from\":0,\"store\":4,\"queue\":4,\"index\":2},{\"from\":1700000000000,\"store\":8,\"queue\":8,\"index\":3}]"
  },
  "durable_objects": { "bindings": [
    { "name": "RUN_STREAMS", "class_name": "RunStreams" },
    { "name": "QUEUE_SHARD", "class_name": "QueueShard" },
    { "name": "SINK", "class_name": "Sink" },
    { "name": "WORLD_STORE", "class_name": "WorldStore" },
    { "name": "RUNNER", "class_name": "Runner" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunStreams", "QueueShard", "Sink", "WorldStore"] }, { "tag": "v2", "new_sqlite_classes": ["Runner"] }],
  "r2_buckets": [
    { "binding": "DLQ", "bucket_name": "worlds-test-dlq" },
    { "binding": "PAYLOADS", "bucket_name": "worlds-test-payloads" }
  ],
  "services": [{ "binding": "CONSUMER", "service": "worlds-test", "entrypoint": "QueueConsumer" }]
}
